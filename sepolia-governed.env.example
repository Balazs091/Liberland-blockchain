# Full synthetic Sepolia governance staging. Merge into ignored .env.local and load it locally.
# All eight role addresses below are PUBLIC addresses. Their owners need Sepolia ETH to exercise their roles.
# Never put a mainnet key here, commit a key, or send one in chat.
SEPOLIA_RPC_URL=https://your-sepolia-rpc.example
SEPOLIA_GOVERNED_PRIVATE_KEY=0xreplace-with-testnet-only-key

# Three wallets controlled by separate testers; all distinct from the deployer and each other.
SEPOLIA_GOVERNED_TESTER_1=0xreplace-with-public-address
SEPOLIA_GOVERNED_TESTER_2=0xreplace-with-public-address
SEPOLIA_GOVERNED_TESTER_3=0xreplace-with-public-address

# Five distinct review wallets, separate from the deployer and all three testers.
CIVIC_REVIEWER_0=0xreplace-with-public-address
CIVIC_REVIEWER_1=0xreplace-with-public-address
CIVIC_REVIEWER_2=0xreplace-with-public-address
CIVIC_REVIEWER_3=0xreplace-with-public-address
CIVIC_REVIEWER_4=0xreplace-with-public-address

# Optional explorer source verification, after deployment.
ETHERSCAN_API_KEY=
