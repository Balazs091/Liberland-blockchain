SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/replace-me
MAINNET_RPC_URL=https://mainnet.infura.io/v3/replace-me
PRIVATE_KEY=0xreplace-me
ETHERSCAN_API_KEY=replace-me

# Required for production; optional overrides for the Sepolia demo.
# FINANCE_ADMIN=0x...
# IDENTITY_ADMIN=0x...
# LAND_ADMIN=0x...
# COMPANY_REGISTRY_ADMIN=0x...

# Required production money configuration for scripts/Deploy.s.sol.
# System money is ERC20: LLM plus the configured treasury spending assets (e.g. USDC, USDS).
# Native ETH is gas-only. LLM_TOKEN is also the referendum proposal-fee and contribution-reward asset.
# The token must use 18 decimals, expose cap() == 70000000e18, and enforce that cap in non-upgradeable code.
# Treasury has no mint path. Include LLM_TOKEN in the treasury asset list so approved rewards can be paid.
# USDC_TOKEN is the real 6-decimal USDC used by the production lending pool and may also be a treasury asset.
# Clerk limits are per payout in each asset's smallest units (LLM has 18 decimals, USDC/USDS differ).
# LLM_TOKEN=0x...
# USDC_TOKEN=0x...
# TREASURY_ASSET_COUNT=2
# TREASURY_ASSET_0_ADDRESS=0x...   # e.g. the LLM token
# TREASURY_ASSET_0_CLERK_OPERATIONS_LIMIT=3000000000000000000000
# TREASURY_ASSET_0_CLERK_SALARY_LIMIT=2000000000000000000000
# TREASURY_ASSET_1_ADDRESS=0x...   # e.g. USDC (6 decimals)
# TREASURY_ASSET_1_CLERK_OPERATIONS_LIMIT=3000000000
# TREASURY_ASSET_1_CLERK_SALARY_LIMIT=2000000000

# Required production genesis seed inputs for scripts/Deploy.s.sol.
# Person IDs and metadata hashes must be 32-byte 0x-prefixed hex values.
# Repeat the GENESIS_CITIZEN_N group for every index from 0 to GENESIS_CITIZEN_COUNT - 1.
# LLM uses the standard 18 ERC20 decimals, so ACTIVE_STAKE is in base units: 1 whole LLM = 1000000000000000000.
# The deployer wallet must hold at least the sum of every configured ACTIVE_STAKE; deployment transfers that exact
# backing into LLMStakingVault before the accounting credit is created.
# The examples below are 20000 LLM and 7500 LLM (must be >= MINIMUM_CITIZEN_STAKE = 5000 LLM).
# Ethereum mainnet requires at least seven eligible citizens because all seven Congress seats are pre-populated.
# GENESIS_CITIZEN_COUNT=7
# GENESIS_CITIZEN_0_PERSON_ID=0x...
# GENESIS_CITIZEN_0_WALLET=0x...
# GENESIS_CITIZEN_0_ACTIVE_STAKE=20000000000000000000000
# GENESIS_CITIZEN_0_METADATA_HASH=0x...
# GENESIS_CITIZEN_0_METADATA_URI=ipfs://...
# GENESIS_CITIZEN_1_PERSON_ID=0x...
# GENESIS_CITIZEN_1_WALLET=0x...
# GENESIS_CITIZEN_1_ACTIVE_STAKE=7500000000000000000000
# GENESIS_CITIZEN_1_METADATA_HASH=0x...
# GENESIS_CITIZEN_1_METADATA_URI=ipfs://...
# GENESIS_SENATE_SEAT_COUNT=2
# GENESIS_SENATE_SEAT_0_CITIZEN_INDEX=0
# GENESIS_SENATE_SEAT_1_CITIZEN_INDEX=1
# The imported cycle end is an absolute Unix timestamp. It must be in the future, no more than 90 days away,
# leave the minimum nomination and voting windows, and land exactly at 17:00 UTC (18:00 fixed CET).
# GENESIS_CONGRESS_MEMBER_COUNT=7
# GENESIS_CONGRESS_MEMBER_0_CITIZEN_INDEX=0
# GENESIS_CONGRESS_MEMBER_1_CITIZEN_INDEX=1
# GENESIS_CONGRESS_MEMBER_2_CITIZEN_INDEX=2
# GENESIS_CONGRESS_MEMBER_3_CITIZEN_INDEX=3
# GENESIS_CONGRESS_MEMBER_4_CITIZEN_INDEX=4
# GENESIS_CONGRESS_MEMBER_5_CITIZEN_INDEX=5
# GENESIS_CONGRESS_MEMBER_6_CITIZEN_INDEX=6
# GENESIS_CONGRESS_CYCLE_END_TIMESTAMP=<future Unix timestamp at 17:00 UTC>
# GENESIS_PRESIDENT_CITIZEN_INDEX=0
# GENESIS_PRESIDENT_MANDATE_HASH=0x...

# Optional demo deployment knobs.
# The demo treasury is always prefunded with enough mock USDC for the seeded budget; these add extra on top.
# FINANCE_CLERK=0x...
# TREASURY_PREFUND_USDC=5000000000
# TREASURY_PREFUND_LLM=1000000000000000000000
